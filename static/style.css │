@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins', sans-serif;
}

body{
    min-height:100vh;
    background:linear-gradient(135deg,#0f172a,#1e293b,#334155);
}

.overlay{
    width:100%;
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:30px;
}

.main-card,
.result-card{
    width:100%;
    max-width:1000px;
    background:rgba(255,255,255,0.08);
    backdrop-filter:blur(14px);
    border-radius:25px;
    padding:40px;
    box-shadow:0 8px 32px rgba(0,0,0,0.3);
    color:white;
}

.result-card{
    max-width:600px;
    text-align:center;
}

.title,
.result-title{
    font-size:40px;
    font-weight:700;
    text-align:center;
    margin-bottom:10px;
}

.subtitle{
    text-align:center;
    margin-bottom:35px;
    color:#cbd5e1;
}

.custom-input{
    height:55px;
    border:none;
    border-radius:12px;
    background:rgba(255,255,255,0.12);
    color:white;
    padding-left:15px;
}

.custom-input::placeholder{
    color:#d1d5db;
}

.custom-input:focus{
    background:rgba(255,255,255,0.18);
    color:white;
    box-shadow:none;
}

.predict-btn,
.back-btn{
    background:linear-gradient(135deg,#06b6d4,#3b82f6);
    color:white;
    border:none;
    padding:14px 35px;
    border-radius:14px;
    text-decoration:none;
    font-weight:600;
    transition:0.3s;
}

.predict-btn:hover,
.back-btn:hover{
    transform:translateY(-3px);
}

.alert{
    border-radius:18px;
    padding:25px;
    margin-top:25px;
}

.result-message{
    margin-top:20px;
    font-size:18px;
}

.alert-danger{
    background:rgba(239,68,68,0.2);
    color:#fecaca;
}

.alert-success{
    background:rgba(34,197,94,0.2);
    color:#bbf7d0;
}